Randomized::Randomized(){
	for (int i = 0; i < 26; i++) {
		TableauStat[i] = 1.0;
	}
}

void Randomized::Erreur(int Index){

   float Tot = 0;
   TableauStat[Index] += 1.0;
   for (int i = 0; i < ; i++) {
      Tot += TableauStat[i];
   }
   ProbaSRand = Tot;

}

void Randomized::Reussite(int Index){

	float Tot = 0;
	if(TableauStat[Index] > 0.4) TableauStat[Index] -= 0.3
	for (int i = 0; i < ; i++) {
	  Tot += TableauStat[i];
	}
	ProbaSRand = Tot;
}

int Randomized::Tirage(float PlageProbaTire){

	float value = 0.0;
	for (int i = 0; i < 26; i++) {
		if(value > PlageProbaTire){
			return i;
		}
		else value += TableauStat[i];
	}
}

void Randomized::LogProba(){
	std::ofstream Log("data/log/Log.txt", std::ios_base::app);
	Log << "\n";
	Tot = 0;




	for (int i = 0; i < 26; i++) {
		Tot += TableauStat[i];
		Log << TableauStat[i];
		Log << " ";

	}
    Log << "Voici Tot : " << Tot;
}


void Randomized::ResetProb(){
	for (int i = 0; i < 26; ++i) {
		TableauStat[i] = 1.0;
	}
}
